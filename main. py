import os, requests, uvicorn
import pandas as pd, numpy as np
from typing import List
from fastapi import FastAPI
from fastapi.responses import HTMLResponse, JSONResponse
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

app = FastAPI()
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])

class BatchRequest(BaseModel):
    tickers: List[str]

def calculate_rsi(series: pd.Series, period: int = 14) -> float:
    delta = series.diff()
    gain = (delta.where(delta > 0, 0)).rolling(period).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(period).mean()
    return float((100 - (100 / (1 + (gain / loss)))).iloc[-1])

def get_prices(ticker: str):
    try:
        url = f"https://query1.finance.yahoo.com/v8/finance/chart/{ticker}?range=1y&interval=1d"
        res = requests.get(url, headers={'User-Agent': 'Mozilla/5.0'}, timeout=5)
        if res.status_code == 200:
            data = res.json()['chart']['result'][0]
            clean = [(pd.to_datetime(ts, unit='s'), cl) for ts, cl in zip(data['timestamp'], data['indicators']['quote'][0]['close']) if cl]
            if len(clean) > 50:
                d, v = zip(*clean)
                return pd.Series(v, index=d), "Yahoo API"
    except: pass
    return None, "Offline"

@app.post("/api/stocks/batch")
def get_batch(payload: BatchRequest):
    msci, _ = get_prices("URTH")
    results = []
    for t in payload.tickers:
        p, src = get_prices(t)
        if p is None or len(p) < 20: continue
        lp = float(p.iloc[-1])
        lb = min(63, len(p) - 1)
        m3 = ((lp - float(p.iloc[-lb])) / float(p.iloc[-lb])) * 100
        vs = m3 - (((float(msci.iloc[-1]) - float(msci.iloc[-lb])) / float(msci.iloc[-lb])) * 100) if msci is not None else 0
        rsi = calculate_rsi(p)
        sma = float(p.rolling(min(200, len(p))).mean().iloc[-1])
        dist = ((lp - sma) / sma) * 100
        sig = "LONG" if (m3 > 0 and dist > 0 and rsi > 45) else "SHORT"
        results.append({
            "ticker": t, "name": t, "price": round(lp, 2), "signal": sig,
            "momentum3m": f"{m3:+.1f}%", "momentumVsMsci": f"{vs:+.1f}%",
            "volatility": f"{float(p.pct_change().dropna().tail(30).std() * np.sqrt(252) * 100):.1f}%",
            "liquidity": f"Aktiv ({src})", "sma200": f"{'Über' if dist>=0 else 'Unter'} SMA200 ({dist:+.1f}%)",
            "rsi": round(rsi, 1), "range52w": f"${float(p.tail(252).min()):.2f} - ${float(p.tail(252).max()):.2f}",
            "chartPoints": p.tail(12).round(2).tolist()
        })
    return {"data": results, "timestamp": pd.Timestamp.now().strftime("%H:%M:%S")}

@app.get("/manifest.json")
def manifest():
    return JSONResponse({"short_name":"Momentum","name":"Momentum Radar","start_url":"/","display":"standalone","background_color":"#080a0f","theme_color":"#080a0f"})

@app.get("/sw.js")
def sw():
    return HTMLResponse("self.addEventListener('fetch', e => e.respondWith(fetch(e.request)));", media_type="application/javascript")

@app.get("/", response_class=HTMLResponse)
def index():
    with open("templates/index.html", encoding="utf-8") as f: return f.read()

if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("PORT", 8000)))
